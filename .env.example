# Cal.com public booking links (username is not flutterly — that profile 404s).
# Defaults in src/lib/cal.ts match Olivia’s live Flutterly events.
# Set on Vercel project "website" only if you need to override.
# NEXT_PUBLIC_CAL_USERNAME=anoop-jose-jtij1j
# NEXT_PUBLIC_CAL_ORIGIN=https://cal.com
# NEXT_PUBLIC_CAL_EVENT_INTRO=intro
# NEXT_PUBLIC_CAL_EVENT_CONSULTATION=consultation
# NEXT_PUBLIC_CAL_EVENT_SCOPING=project-scoping

# Production: enable only after implementing the database-backed adapter in
# src/features/gp-cms/auth/production-adapter.ts.
GP_CMS_AUTH_MODE=production
GP_CMS_AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Local demo only, never set this mode in Vercel production.
# GP_CMS_AUTH_MODE=demo
# GP_CMS_AUTH_SECRET=local-only-random-secret-of-at-least-32-characters
